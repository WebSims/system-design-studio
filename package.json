{
  "name": "system-design-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --filter @sds/studio dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @sds/studio build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && tsc -p apps/studio/tsconfig.json",
    "verify": "pnpm typecheck && pnpm test",
    "sim": "vite-node scripts/report.ts --",
    "browser": "vite-node scripts/browser.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vite-node": "^2.1.9",
    "@sds/schema": "workspace:*",
    "@sds/core": "workspace:*",
    "@sds/analytic": "workspace:*",
    "@sds/models": "workspace:*",
    "@sds/analyze": "workspace:*",
    "@sds/kernel": "workspace:*",
    "@sds/explore": "workspace:*",
    "@sds/study": "workspace:*"
  }
}